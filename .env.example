# Firebase compartilhado entre o painel web e o aplicativo Android.
# Preencha somente no ambiente local ou na Vercel. Não publique valores reais.

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# App Check Web (reCAPTCHA v3). Ative no Firebase Console antes de exigir enforcement.
VITE_FIREBASE_APPCHECK_SITE_KEY=""

# Ative somente após deploy/teste das Cloud Functions e App Check.
VITE_USE_TRUSTED_BACKEND="false"


# Exibe controles de simulação somente em ambientes de demonstração.
VITE_ENABLE_DEMO_MODE="false"
