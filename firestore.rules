rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isActiveOperator() {
      return hasVerifiedEmail()
        && exists(/databases/$(database)/documents/operators/$(request.auth.uid))
        && get(/databases/$(database)/documents/operators/$(request.auth.uid)).data.active == true;
    }

    function isActiveOperatorFor(institutionId) {
      return isActiveOperator()
        && get(/databases/$(database)/documents/operators/$(request.auth.uid)).data.keys().hasAll(['institutionId'])
        && get(/databases/$(database)/documents/operators/$(request.auth.uid)).data.institutionId == institutionId;
    }

    function isActiveMemberOf(institutionId) {
      return hasVerifiedEmail()
        && exists(/databases/$(database)/documents/memberships/$(request.auth.uid))
        && get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.keys().hasAll(['institutionId', 'active'])
        && get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.institutionId == institutionId
        && get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.active == true;
    }

    function isOwner() {
      return isSignedIn()
        && resource.data.authUid == request.auth.uid
        && isActiveMemberOf(resource.data.institutionId);
    }

    function isOwnerOnCreate() {
      return hasVerifiedEmail()
        && request.resource.data.authUid == request.auth.uid
        && isActiveMemberOf(request.resource.data.institutionId);
    }

    function isValidCoordinate(coordinate) {
      return coordinate is map
        && coordinate.keys().hasAll(['lat', 'lng'])
        && (coordinate.lat == null || coordinate.lat is number)
        && (coordinate.lng == null || coordinate.lng is number)
        && (coordinate.lat == null || (coordinate.lat >= -90 && coordinate.lat <= 90))
        && (coordinate.lng == null || (coordinate.lng >= -180 && coordinate.lng <= 180));
    }

    function isValidAlertStatus(status) {
      return status in [
        'pendente',
        'em_deslocamento',
        'no_local',
        'resolvido',
        'cancelado_usuario'
      ];
    }

    function isValidReceiptStatus(status) {
      return status in ['aguardando_central', 'recebido_pela_central'];
    }

    function hasValidUserProfile(profile) {
      return profile is map
        && profile.keys().hasOnly([
          'id',
          'institutionId',
          'name',
          'documentNumber',
          'role',
          'phone',
          'email',
          'emergencyContactName',
          'emergencyContactPhone',
          'emergencyContactRelation',
          'emergencyContacts',
          'department',
          'registeredAt',
          'avatarSeed',
          'preferredCampusId'
        ]);
    }

    function hasValidAlertIdentity(data) {
      return data.keys().hasAll([
          'id',
          'institutionId',
          'authUid',
          'protocolNumber',
          'userId',
          'userProfile',
          'category',
          'status',
          'receiptStatus',
          'retentionExpiresAt',
          'createdAt',
          'updatedAt',
          'location',
          'locationName',
          'isInsideCampus',
          'signalLost',
          'lastSignalTimestamp'
        ])
        && data.id is string
        && data.id.size() > 0
        && data.id.size() <= 100
        && data.institutionId is string
        && data.institutionId.size() > 0
        && data.institutionId.size() <= 100
        && data.authUid is string
        && data.authUid.size() > 0
        && data.authUid.size() <= 160
        && data.protocolNumber is string
        && data.protocolNumber.size() > 0
        && data.protocolNumber.size() <= 80
        && data.userId is string
        && data.userId.size() > 0
        && data.userId.size() <= 160
        && hasValidUserProfile(data.userProfile)
        && (!data.userProfile.keys().hasAny(['institutionId'])
          || data.userProfile.institutionId == data.institutionId)
        && data.category in [
          'urgencia_geral',
          'violencia_ameaca',
          'saude_desmaio',
          'perseguicao_suspeito',
          'acidente_queda',
          'area_escura_risco',
          'furto_roubo'
        ]
        && data.status == 'pendente'
        && isValidReceiptStatus(data.receiptStatus)
        && data.receiptStatus == 'aguardando_central'
        && data.retentionExpiresAt is timestamp
        && data.createdAt is string
        && data.createdAt.size() <= 80
        && data.updatedAt is string
        && data.updatedAt.size() <= 80
        && isValidCoordinate(data.location)
        && data.locationName is string
        && data.locationName.size() <= 255
        && data.isInsideCampus is bool
        && data.signalLost is bool
        && data.lastSignalTimestamp is string
        && data.lastSignalTimestamp.size() <= 80;
    }

    function hasValidOptionalAlertFields(data) {
      return (!data.keys().hasAny(['campusId'])
          || (data.campusId is string && data.campusId.size() <= 100))
        && (!data.keys().hasAny(['campusName'])
          || (data.campusName is string && data.campusName.size() <= 160))
        && (!data.keys().hasAny(['customNote'])
          || (data.customNote is string && data.customNote.size() <= 1000))
        && (!data.keys().hasAny(['batteryLevel'])
          || (data.batteryLevel is number
            && data.batteryLevel >= 0
            && data.batteryLevel <= 100))
        && (!data.keys().hasAny(['source'])
          || data.source in ['android', 'web', 'painel', 'api'])
        && (!data.keys().hasAny(['isInSafeZone'])
          || data.isInSafeZone is bool)
        && (!data.keys().hasAny(['safeZoneName'])
          || (data.safeZoneName is string && data.safeZoneName.size() <= 160))
        && (!data.keys().hasAny(['userRouteHistory'])
          || (data.userRouteHistory is list && data.userRouteHistory.size() <= 500))
        && (!data.keys().hasAny(['smsNotificationsSent'])
          || (data.smsNotificationsSent is list && data.smsNotificationsSent.size() <= 20))
        && (!data.keys().hasAny(['photoUrl'])
          || (data.photoUrl is string && data.photoUrl.size() <= 4096))
        && (!data.keys().hasAny(['photoCapturedAt'])
          || (data.photoCapturedAt is string && data.photoCapturedAt.size() <= 80))
        && (!data.keys().hasAny(['photoSource'])
          || data.photoSource in [
            'camera_frontal',
            'camera_traseira',
            'camera_automatica',
            'simulacao_evidencia'
          ])
        && (!data.keys().hasAny(['centralReceiptAt'])
          || (data.centralReceiptAt is string && data.centralReceiptAt.size() <= 80))
        && (!data.keys().hasAny(['centralReceiptByUid'])
          || (data.centralReceiptByUid is string && data.centralReceiptByUid.size() <= 160))
        && (!data.keys().hasAny(['receiptStatus'])
          || isValidReceiptStatus(data.receiptStatus))
        && (!data.keys().hasAny(['lastSecurityNote'])
          || (data.lastSecurityNote is string && data.lastSecurityNote.size() <= 1000))
        && (!data.keys().hasAny(['assignedUnitId'])
          || (data.assignedUnitId is string && data.assignedUnitId.size() <= 160))
        && (!data.keys().hasAny(['assignedUnitName'])
          || (data.assignedUnitName is string && data.assignedUnitName.size() <= 200))
        && (!data.keys().hasAny(['securityNotes'])
          || (data.securityNotes is list && data.securityNotes.size() <= 100))
        && (!data.keys().hasAny(['resolvedAt'])
          || (data.resolvedAt is string && data.resolvedAt.size() <= 80))
        && (!data.keys().hasAny(['responseTimeMinutes'])
          || (data.responseTimeMinutes is number
            && data.responseTimeMinutes >= 0));
    }

    match /emergencyAlerts/{alertId} {
      // O usuário só cria um alerta próprio, dentro da instituição de seu vínculo.
      // Campos operacionais, médicos e de auditoria não podem ser injetados.
      allow create: if isOwnerOnCreate()
        && request.resource.data.keys().hasOnly([
          'id',
          'institutionId',
          'authUid',
          'protocolNumber',
          'userId',
          'userProfile',
          'category',
          'customNote',
          'status',
          'receiptStatus',
          'retentionExpiresAt',
          'createdAt',
          'updatedAt',
          'campusId',
          'campusName',
          'location',
          'locationName',
          'isInsideCampus',
          'isInSafeZone',
          'safeZoneName',
          'signalLost',
          'lastSignalTimestamp',
          'batteryLevel',
          'userRouteHistory',
          'smsNotificationsSent',
          'source'
        ])
        && request.resource.data.id == alertId
        && hasValidAlertIdentity(request.resource.data)
        && hasValidOptionalAlertFields(request.resource.data);

      // Alertas de teste só podem ser criados por operador ativo da mesma instituição.
      allow create: if isActiveOperatorFor(request.resource.data.institutionId)
        && request.resource.data.keys().hasOnly([
          'id',
          'institutionId',
          'authUid',
          'protocolNumber',
          'userId',
          'userProfile',
          'category',
          'customNote',
          'status',
          'receiptStatus',
          'retentionExpiresAt',
          'createdAt',
          'updatedAt',
          'campusId',
          'campusName',
          'location',
          'locationName',
          'isInsideCampus',
          'isInSafeZone',
          'safeZoneName',
          'signalLost',
          'lastSignalTimestamp',
          'batteryLevel',
          'userRouteHistory',
          'smsNotificationsSent',
          'assignedUnitId',
          'assignedUnitName',
          'securityNotes',
          'resolvedAt',
          'responseTimeMinutes',
          'source',
          'photoUrl',
          'photoCapturedAt',
          'photoSource'
        ])
        && request.resource.data.id == alertId
        && request.resource.data.authUid == request.auth.uid
        && hasValidAlertIdentity(request.resource.data)
        && hasValidOptionalAlertFields(request.resource.data);

      // A consulta precisa ser particionada pela instituição; o titular só vê o próprio alerta.
      allow read: if isOwner() || isActiveOperatorFor(resource.data.institutionId);

      // Cancelamento exclusivo do titular; a confirmação da central não é forjada pelo usuário.
      allow update: if isOwner()
        && request.resource.data.id == resource.data.id
        && request.resource.data.institutionId == resource.data.institutionId
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && resource.data.status in ['pendente', 'em_deslocamento', 'no_local']
        && request.resource.data.status == 'cancelado_usuario'
        && request.resource.data.updatedAt is string;

      // A evidência é anexada pelo titular após o upload autorizado no Storage.
      allow update: if isOwner()
        && request.resource.data.id == resource.data.id
        && request.resource.data.institutionId == resource.data.institutionId
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['photoUrl', 'photoCapturedAt', 'photoSource', 'updatedAt'])
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 4096
        && request.resource.data.photoCapturedAt is string
        && request.resource.data.photoCapturedAt.size() <= 80
        && request.resource.data.photoSource in [
          'camera_frontal',
          'camera_traseira',
          'camera_automatica',
          'simulacao_evidencia'
        ]
        && request.resource.data.updatedAt is string;

      // Somente operador ativo da instituição pode alterar despacho, status ou recibo.
      allow update: if isActiveOperatorFor(resource.data.institutionId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.institutionId == resource.data.institutionId
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt',
          'assignedUnitId',
          'assignedUnitName',
          'lastSecurityNote',
          'securityNotes',
          'resolvedAt',
          'responseTimeMinutes',
          'receiptStatus',
          'centralReceiptAt',
          'centralReceiptByUid'
        ])
        && isValidAlertStatus(request.resource.data.status)
        && request.resource.data.status != 'cancelado_usuario'
        && request.resource.data.updatedAt is string
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'receiptStatus',
            'centralReceiptAt',
            'centralReceiptByUid'
          ])
          || (
            request.resource.data.receiptStatus == 'recebido_pela_central'
            && request.resource.data.centralReceiptAt is string
            && request.resource.data.centralReceiptByUid == request.auth.uid
          ));
      
      allow delete: if false;
    }

    match /auditLogs/{eventId} {
      // Auditoria é append-only. O evento deve pertencer à mesma instituição do alerta.
      allow create: if hasVerifiedEmail()
        && request.resource.data.keys().hasOnly([
          'id',
          'institutionId',
          'alertId',
          'actorUid',
          'actorType',
          'eventType',
          'createdAt',
          'retentionExpiresAt',
          'metadata'
        ])
        && request.resource.data.id == eventId
        && request.resource.data.institutionId is string
        && request.resource.data.institutionId.size() > 0
        && request.resource.data.institutionId.size() <= 100
        && request.resource.data.alertId is string
        && request.resource.data.alertId.size() > 0
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorType in ['user', 'operator']
        && request.resource.data.eventType in [
          'alert_created',
          'alert_received',
          'alert_viewed',
          'alert_status_changed',
          'alert_cancelled_by_user',
          'evidence_uploaded'
        ]
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 80
        && request.resource.data.retentionExpiresAt is timestamp
        && (!request.resource.data.keys().hasAny(['metadata'])
          || request.resource.data.metadata is map)
        && (
          (
            request.resource.data.actorType == 'user'
            && isActiveMemberOf(request.resource.data.institutionId)
            && request.resource.data.eventType in [
              'alert_created',
              'alert_cancelled_by_user',
              'evidence_uploaded'
            ]
            && getAfter(/databases/$(database)/documents/emergencyAlerts/$(request.resource.data.alertId)).data.authUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/emergencyAlerts/$(request.resource.data.alertId)).data.institutionId == request.resource.data.institutionId
          )
          || (
            request.resource.data.actorType == 'operator'
            && isActiveOperatorFor(request.resource.data.institutionId)
            && request.resource.data.eventType in [
              'alert_created',
              'alert_received',
              'alert_viewed',
              'alert_status_changed',
              'evidence_uploaded'
            ]
            && getAfter(/databases/$(database)/documents/emergencyAlerts/$(request.resource.data.alertId)).data.institutionId == request.resource.data.institutionId
          )
        );

      allow read: if hasVerifiedEmail()
        && (
          isActiveOperatorFor(resource.data.institutionId)
          || (
            resource.data.actorUid == request.auth.uid
            && isActiveMemberOf(resource.data.institutionId)
          )
        );
      allow update, delete: if false;
    }

    match /memberships/{memberId} {
      // Vínculos são provisionados por administrador/SSO; nunca pelo cliente.
      allow read: if hasVerifiedEmail() && request.auth.uid == memberId;
      allow write: if false;
    }

    match /operators/{operatorId} {
      // O registro de operador é administrado fora do cliente.
      allow read: if hasVerifiedEmail() && request.auth.uid == operatorId;
      allow write: if false;
    }

    match /institutions/{institutionId} {
      allow read: if isActiveMemberOf(institutionId) || isActiveOperatorFor(institutionId);
      allow write: if false;
    }
  }
}
