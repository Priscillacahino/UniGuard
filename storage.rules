rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOperator() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/operators/$(request.auth.uid));
    }
    match /emergency-evidence/{alertId}.jpg {
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/emergencyAlerts/$(alertId)).data.authUid == request.auth.uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if isOperator();
    }
  }
}
