rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOperator() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/operators/$(request.auth.uid))
        && get(/databases/$(database)/documents/operators/$(request.auth.uid)).data.active == true;
    }

    function isOwner() {
      return isSignedIn() && resource.data.authUid == request.auth.uid;
    }

    match /emergencyAlerts/{alertId} {
      // Android/Web do usuário podem criar apenas o próprio alerta e sempre como pendente.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
          'id', 'authUid', 'status', 'createdAt', 'updatedAt', 'location'
        ])
        && request.resource.data.id == alertId
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.status == 'pendente';

      // Dono do alerta visualiza o próprio chamado; operadores visualizam todos.
      allow read: if isOwner() || isOperator();

      // Usuário pode cancelar o próprio alerta sem alterar outros dados.
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'cancelado_usuario';

      // O Android pode associar a foto enviada ao Storage ao próprio alerta.
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['photoUrl', 'photoCapturedAt', 'photoSource', 'updatedAt']);

      // A central altera somente os campos operacionais do atendimento.
      allow update: if isOperator()
        && request.resource.data.id == resource.data.id
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'assignedUnitId', 'assignedUnitName',
          'lastSecurityNote', 'securityNotes', 'resolvedAt'
        ]);

      allow delete: if false;
    }

    match /operators/{operatorId} {
      allow read: if isSignedIn() && request.auth.uid == operatorId;
      allow write: if false;
    }
  }
}
